# API commands read this file; Vite reads only the development ports.
# API file paths are relative to server/.
PORT=4000
WEB_PORT=5173
DATA_FILE=./data/tasks.json
# Change this before hosting the app. Production refuses the development default.
JWT_SECRET=dev-only-insecure-secret
TOKEN_TTL_SECONDS=43200
AUTH_RATE_LIMIT=20
# Leave empty when the frontend and API share an origin (including Vite's proxy).
CORS_ORIGINS=
# To serve the production frontend from Express, uncomment this after npm run build.
# STATIC_DIR=../client/dist
